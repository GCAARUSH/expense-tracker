# Secret used to sign login cookies. Use a long random string.
# (If you leave this out, ADMIN_PASSWORD from the old version is used instead.)
SESSION_SECRET=

# OPTIONAL: if set, people must enter this code to create an account (invite-only).
# Leave empty to let anyone with the site address sign up.
SIGNUP_CODE=

# Added automatically when you connect Upstash Redis in Vercel (Storage tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=
