# Password you use to log in and edit expenses
ADMIN_PASSWORD=change-me-to-something-long

# (Optional) Secret key parents must add to the link: /view?key=THIS_VALUE
# Leave empty to make /view open to anyone who has the URL.
VIEW_KEY=

# Added automatically when you connect Upstash Redis in Vercel (Storage tab).
# For local dev, copy them from the Upstash dashboard:
KV_REST_API_URL=
KV_REST_API_TOKEN=
